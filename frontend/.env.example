# Copy to `.env.local` for local overrides (git-ignored). Not needed for normal local dev —
# the Vite proxy in vite.config.js handles /api locally without this.
#
# Only set this for a build where the frontend and backend are on different domains
# (e.g. deploying to Netlify with the backend on Render). Point it at the deployed
# backend — either the bare origin or with /api/v1 already appended both work,
# src/lib/api.js normalizes it either way:
# VITE_API_URL=https://your-backend.onrender.com
