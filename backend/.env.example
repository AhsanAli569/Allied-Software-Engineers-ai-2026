# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---
APP_NAME="ASE AI"
ENVIRONMENT=development
DEBUG=true
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000
# "lax" when frontend+backend share a domain (VPS behind nginx, local dev).
# "none" when they're on different domains (e.g. Netlify frontend + Render backend) —
# required for cross-site cookies to be sent at all.
COOKIE_SAMESITE=lax

# --- Database ---
# Native PostgreSQL (Windows): install PostgreSQL 16, create a database, then:
DATABASE_URL=postgresql+asyncpg://ase_ai:changeme@localhost:5432/ase_ai

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- AI Providers (backend-only, never exposed to the browser) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Rate limiting (dev: in-memory; swap for Redis in production) ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- File uploads ---
STORAGE_DIR=./storage
MAX_IMAGE_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=20
MAX_ATTACHMENTS_PER_MESSAGE=5
