# Copy to `.env` in the repo root (docker compose reads it automatically for the
# ${POSTGRES_*} substitutions in docker-compose.prod.yml). This is separate from
# backend/.env, which holds the app's own secrets (JWT_SECRET, provider API keys, etc.)
# and is loaded into the backend container via env_file.

POSTGRES_USER=ase_ai
POSTGRES_PASSWORD=changeme-generate-a-real-password
POSTGRES_DB=ase_ai
